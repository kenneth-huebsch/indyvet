DATABASE_URI=postgres://vetic:vetic-dev@localhost:5432/vetic
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional — when set, Media uploads go to S3 (production). Leave unset for local disk `media/`.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional — set true for Lightsail/RDS Postgres (enables TLS without sslmode in DATABASE_URI).
DATABASE_SSL=
